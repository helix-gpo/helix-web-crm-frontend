  to {
    transform: rotate(360deg);
  }
}

.field input {
  // ... bestehende Styles bleiben ...

  // Browser überschreiben bei Autofill die Hintergrundfarbe unabhängig
  // von normalem CSS - dieser Trick mit riesigem inset-box-shadow
  // "übermalt" den Autofill-Hintergrund zuverlässig
