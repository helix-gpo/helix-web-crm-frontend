        </div>

        <span class="contact-cell">{{ tenant.contactEmail || '–' }}</span>
        <span class="city-cell">{{ tenant.address?.city || '–' }}</span>

        <span class="status-badge" [class]="'status-badge--' + tenant.status.toLowerCase()">
          {{ statusLabels[tenant.status] }}
        </span>

        <span class="website-badge" [class.website-badge--active]="tenant.visibleOnWebsite">
          <span class="material-symbols-rounded">
            {{ tenant.visibleOnWebsite ? 'visibility' : 'visibility_off' }}
          </span>
        </span>

        <button
          class="row-menu-button"
          [matMenuTriggerFor]="menu"
          (click)="$event.stopPropagation()"
        >
          <span class="material-symbols-rounded">more_vert</span>
        </button>

        <mat-menu #menu="matMenu" class="app-menu-panel">
          <button mat-menu-item (click)="openDetail(tenant.id)">
            <span class="menu-item-row">
              <span class="material-symbols-rounded menu-icon">visibility</span>
              <span>Details ansehen</span>
            </span>
          </button>
          <button mat-menu-item (click)="openEditCoreDetails(tenant); $event.stopPropagation()">
            <span class="menu-item-row">
              <span class="material-symbols-rounded menu-icon">business_center</span>
              <span>Stammdaten bearbeiten</span>
            </span>
          </button>
          @if (tenant.status !== 'ACTIVE') {
            <button mat-menu-item (click)="activate(tenant)">
              <span class="menu-item-row">
                <span class="material-symbols-rounded menu-icon">check_circle</span>
                <span>Aktivieren</span>
              </span>
            </button>
          }
          @if (tenant.status !== 'ARCHIVED') {
            <mat-divider></mat-divider>
            <button mat-menu-item (click)="archive(tenant)">
              <span class="menu-item-row">
                <span class="material-symbols-rounded menu-icon">archive</span>
                <span>Archivieren</span>
              </span>
            </button>
