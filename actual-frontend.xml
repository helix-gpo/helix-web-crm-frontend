    </p>
  </div>
</div>

@if (!loading()) {
  <div class="stats-row">
    <div class="stat-card">
      <span class="material-symbols-rounded">payments</span>
      <div>
        <p class="stat-value">{{ formatAmount(openAmount()) }}</p>
        <p class="stat-label">Offener Betrag</p>
