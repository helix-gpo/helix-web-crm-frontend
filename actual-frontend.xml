  <div class="state-panel state-panel--error">
    <span class="material-symbols-rounded">error</span>
    <p>{{ tenantStore.error() }}</p>
    <button class="retry-button" (click)="tenantStore.reload()">Erneut versuchen</button>
  </div>
} @else {
  <div class="tenants-table">
    <div class="table-row table-row--header">
      <span>Mandant</span>
      <span>Kontakt</span>
      <span>Ort</span>
      <span>Status</span>
      <span>Website</span>
      <span></span>
    </div>

    @for (tenant of filteredTenants(); track tenant.id) {
      <div class="table-row" (click)="openDetail(tenant.id)">
        <div class="tenant-cell">
          <app-avatar [name]="tenant.companyName"></app-avatar>
          <div>
            <p class="tenant-name">{{ tenant.companyName }}</p>
            @if (tenant.vatId) {
