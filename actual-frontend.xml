        </div>

        @for (item of inv.lineItems; track item.id) {
          <div class="line-item-row">
            <div class="line-item-main">
              <span class="line-item-source-icon material-symbols-rounded">
                {{ item.source === 'MILESTONE' ? 'flag' : 'edit_note' }}
              </span>
              <div>
                <p class="line-item-description">{{ item.description }}</p>
                <p class="line-item-meta">
                  {{ item.quantity }} × {{ formatMoney(item.unitPrice) }} ·
                  {{ item.taxRatePercentage }} % USt
                </p>
              </div>
            </div>
            <span class="line-item-gross">{{ formatMoney(item.grossAmount) }}</span>
            @if (isDraft()) {
              <div class="line-item-actions">
                <button
                  class="icon-button"
                  (click)="openEditLineItemDialog(item)"
                  title="Bearbeiten"
                >
                  <span class="material-symbols-rounded">edit</span>
                </button>
                <button
                  class="icon-button icon-button--danger"
                  (click)="removeLineItem(item)"
                  title="Entfernen"
                >
                  <span class="material-symbols-rounded">delete</span>
                </button>
              </div>
            }
          </div>
        } @empty {
          <p class="empty-hint">Noch keine Positionen auf dieser Rechnung.</p>
        }
      </div>
    </div>

    <aside class="detail-sidebar">
      @if (isDraft()) {
        <button
          class="issue-button"
          [disabled]="issuing() || inv.lineItems.length === 0"
          (click)="issueInvoice()"
        >
          @if (!issuing()) {
            <span class="material-symbols-rounded">task_alt</span>
            <span>Rechnung ausstellen</span>
          } @else {
            <span class="material-symbols-rounded spin">progress_activity</span>
          }
        </button>
      }

      @if (inv.status !== 'DRAFT' && inv.documentKey) {
        <button class="issue-button" (click)="openDocument()">
          <span class="material-symbols-rounded">description</span>
          <span>Rechnung öffnen (PDF)</span>
        </button>
      }

      <div class="sidebar-card">
        <p class="sidebar-label">Summen</p>
        <div class="summary-row">
          <span>Netto</span>
          <span>{{ formatMoney(inv.netTotal) }}</span>
        </div>
        <div class="summary-row summary-row--muted">
          <span>USt</span>
          <span>{{ formatMoney(inv.taxTotal) }}</span>
        </div>
        <div class="summary-row summary-row--total">
          <span>Brutto</span>
          <span>{{ formatMoney(inv.grossTotal) }}</span>
        </div>
      </div>

      <div class="sidebar-card">
        <div class="sidebar-label-row">
          <p class="sidebar-label">Details</p>
          @if (isDraft() && !editingHeader()) {
            <button class="inline-edit-button" (click)="startEditHeader()" title="Bearbeiten">
              <span class="material-symbols-rounded">edit</span>
            </button>
          }
        </div>

        @if (editingHeader()) {
          <div class="header-edit-form">
            <input
              type="text"
              placeholder="Auftrags-Referenz"
              [value]="headerBuyerReference()"
              (input)="headerBuyerReference.set($any($event.target).value)"
            />
            <input
              type="text"
              placeholder="Zahlungsziel (Tage)"
              [value]="headerPaymentTermsDays()"
              (input)="headerPaymentTermsDays.set($any($event.target).value)"
            />
            <div class="header-edit-actions">
              <button class="cancel-button" (click)="cancelEditHeader()">Abbrechen</button>
              <button class="submit-button" [disabled]="savingHeader()" (click)="saveHeader()">
                Speichern
              </button>
            </div>
          </div>
        } @else {
          <div class="detail-row">
            <span>Ausgestellt</span>
            <span>{{ inv.issueDate || '–' }}</span>
          </div>
          <div class="detail-row">
            <span>Fällig</span>
            <span>{{ inv.dueDate || '–' }}</span>
          </div>
          <div class="detail-row">
            <span>Zahlungsziel</span>
            <span>{{ inv.paymentTermsDays ? inv.paymentTermsDays + ' Tage' : '–' }}</span>
          </div>
          @if (inv.buyerReference) {
            <div class="detail-row">
              <span>Referenz</span>
              <span>{{ inv.buyerReference }}</span>
            </div>
          }
        }
      </div>

      @if (isDraft()) {
        <button
          class="delete-draft-button"
          [disabled]="deletingDraft()"
          (click)="deleteDraftInvoice()"
        >
          <span class="material-symbols-rounded">delete</span>
          <span>Entwurf löschen</span>
        </button>
      }
    </aside>
  </div>
} @else if (loading()) {
  <div class="state-panel">
    <span class="material-symbols-rounded spin">progress_activity</span>
    <p>Rechnung wird geladen...</p>
  </div>
}
</file>

<file path="src/app/pages/project-details/project-details.html">
@if (project(); as p) {
  <div class="detail-hero">
    <div class="detail-hero-pattern"></div>
    <div class="detail-hero-content">
      <button class="back-button" (click)="back()">
        <span class="material-symbols-rounded">arrow_back</span>
        <span>Alle Projekte</span>
      </button>

      <p class="hero-tenant">{{ tenantName() }}</p>
      <h1 class="hero-title">{{ p.title }}</h1>

      @if (p.tags.length > 0) {
        <div class="hero-tags">
          @for (tag of p.tags; track tag.value) {
            <span
              class="hero-tag"
              [style.background-color]="tag.colorHex"
              [style.color]="getContrastTextColor(tag.colorHex)"
              >{{ tag.value }}</span
            >
          }
        </div>
      }
    </div>
  </div>

  <div class="detail-body">
    <div class="detail-main">
      @if (p.description || p.fullDescription) {
        <div class="info-card">
          @if (p.description) {
            <p class="project-intro">{{ p.description }}</p>
          }
          @if (p.fullDescription) {
            <p class="project-full">{{ p.fullDescription }}</p>
          }
        </div>
      }

      @if (p.highlights.length > 0) {
        <div class="info-card">
          <p class="info-card-title">Highlights</p>
          <ul class="highlight-list">
            @for (highlight of p.highlights; track highlight) {
              <li>
                <span class="material-symbols-rounded">check_circle</span>
                <span>{{ highlight }}</span>
              </li>
            }
          </ul>
        </div>
      }

      <div class="info-card">
        <div class="info-card-header">
          <p class="info-card-title">Meilensteine</p>
          <button
            class="add-icon-button"
            (click)="openAddMilestoneDialog()"
            title="Meilenstein hinzufügen"
          >
            <span class="material-symbols-rounded">add</span>
          </button>
        </div>

        @for (milestone of p.milestones; track milestone.id) {
          <div class="milestone-row" [class.milestone-row--done]="milestone.status === 'DONE'">
            <div class="milestone-status-icon">
              <span class="material-symbols-rounded">
                {{ milestone.status === 'DONE' ? 'check_circle' : 'radio_button_unchecked' }}
              </span>
            </div>
            <div class="milestone-info">
              <p class="milestone-title">{{ milestone.title }}</p>
              <p class="milestone-meta">
                {{ milestone.dueDate || 'Kein Datum' }} · {{ formatMoney(milestone.price) }}
              </p>
            </div>
            <div class="milestone-actions">
              <button
                class="icon-button"
                (click)="toggleMilestoneStatus(milestone)"
                [title]="milestone.status === 'DONE' ? 'Als offen markieren' : 'Abschließen'"
              >
                <span class="material-symbols-rounded">
                  {{ milestone.status === 'DONE' ? 'replay' : 'done' }}
                </span>
              </button>
              <button
                class="icon-button"
                (click)="openEditMilestoneDialog(milestone)"
                title="Bearbeiten"
              >
                <span class="material-symbols-rounded">edit</span>
              </button>
              <button
                class="icon-button icon-button--danger"
                (click)="deleteMilestone(milestone)"
                title="Entfernen"
              >
                <span class="material-symbols-rounded">delete</span>
              </button>
            </div>
          </div>
        } @empty {
          <p class="empty-hint">Noch keine Meilensteine angelegt.</p>
        }
      </div>
    </div>

    <aside class="detail-sidebar">
      <div class="sidebar-card">
        <p class="sidebar-label">Status</p>
        <select
          class="status-select"
          [disabled]="changingStatus()"
          (change)="changeStatus($any($event.target).value)"
        >
          @for (option of statusOptions; track option.value) {
            <option [value]="option.value" [selected]="option.value === p.status">
              {{ option.label }}
            </option>
          }
        </select>
      </div>

      <div class="sidebar-card">
        <p class="sidebar-label">Website-Sichtbarkeit</p>
        <button
          class="website-toggle"
          [class.website-toggle--active]="p.visibleOnWebsite"
          [disabled]="togglingPublish()"
          (click)="togglePublish()"
        >
          <span class="material-symbols-rounded">
            {{ p.visibleOnWebsite ? 'visibility' : 'visibility_off' }}
          </span>
          <span>{{
            p.visibleOnWebsite
              ? 'Sichtbar - klicken zum Verbergen'
              : 'Nicht sichtbar - klicken zum Veröffentlichen'
          }}</span>
        </button>
      </div>

      <div class="sidebar-card sidebar-card--dark">
        <p class="sidebar-label sidebar-label--light">Schnellaktionen</p>
        <button class="sidebar-action" (click)="openEditDialog()">
          <span class="material-symbols-rounded">edit</span>
          <span>Projekt bearbeiten</span>
        </button>
        <button class="sidebar-action" (click)="openCreateInvoiceDialog()">
          <span class="material-symbols-rounded">receipt_long</span>
          <span>Rechnung erstellen</span>
        </button>
      </div>
    </aside>
  </div>
} @else if (loading()) {
  <div class="state-panel">
    <span class="material-symbols-rounded spin">progress_activity</span>
    <p>Projekt wird geladen...</p>
  </div>
}
</file>

<file path="src/app/pages/project-details/project-details.scss">
@use '../../../styles' as *;

.detail-hero {
  background: linear-gradient(135deg, var(--main-navy) 0%, var(--main-navy-light) 100%);
  padding: 4rem 3.2rem 5.6rem;
  position: relative;
  overflow: hidden;
  margin: -3.2rem -3.2rem 0;
}

.detail-hero-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1.5px, transparent 1.5px);
  background-size: 2.4rem 2.4rem;
  mask-image: linear-gradient(180deg, black, transparent);
}

.detail-hero-content {
  position: relative;
  z-index: 1;
  max-width: 100rem;
}

.back-button {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  background-color: rgba(255, 255, 255, 0.08);
  border: none;
  border-radius: 50rem;
  padding: 0.8rem 1.6rem 0.8rem 1.2rem;
  color: var(--text-light);
  font-size: 1.3rem;
  cursor: pointer;
  margin-bottom: 2.4rem;

  &:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }
}

.hero-tenant {
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--accent-cyan);
  text-transform: uppercase;
  letter-spacing: 0.04rem;
  margin-bottom: 0.8rem;
}

.hero-title {
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--text-light);
  margin-bottom: 1.6rem;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.hero-tag {
  font-size: 1.2rem;
  font-weight: 600;
  padding: 0.4rem 1.2rem;
  border-radius: 50rem;
  border: 1px solid rgba(255, 255, 255, 0.15); // verhindert das "Verschmelzen" mit dem Hero-Hintergrund
}

.detail-body {
  max-width: 100rem;
  margin: -3.2rem auto 0;
  display: grid;
  grid-template-columns: 1fr 28rem;
  gap: 2.4rem;
  position: relative;
  z-index: 1;
  padding-bottom: 3.2rem;

  @include respond(md) {
    grid-template-columns: 1fr;
  }
}

.detail-main {
  @include flex-col(2rem);
}

.project-intro {
  font-size: 1.7rem;
  font-weight: 600;
  color: var(--text-dark);
  line-height: 1.5;
  margin-bottom: 1.2rem;
}

.project-full {
  font-size: 1.5rem;
  color: var(--text-grey);
  line-height: 1.7;
}

.info-card {
  @include card-surface;
  padding: 2.4rem;
}

.info-card-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 1.6rem;
}

.info-card-header .info-card-title {
  margin-bottom: 0;
}

.add-icon-button {
  width: 2.8rem;
  height: 2.8rem;
  border-radius: 50%;
  border: none;
  background-color: var(--accent-cyan-light);
  color: var(--accent-cyan-hover);
  cursor: pointer;
  @include flex-center;

  &:hover {
    background-color: var(--accent-cyan);
    color: var(--text-light);
  }
}

.highlight-list {
  list-style: none;
  @include flex-col(1rem);

  li {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.4rem;
    color: var(--text-dark);

    .material-symbols-rounded {
      color: var(--accent-cyan);
      font-size: 1.8rem;
    }
  }
}

.milestone-row {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  padding: 1.2rem 0;
  border-top: 1px solid var(--bg-light);

  &:first-of-type {
    border-top: none;
  }

  &--done {
    opacity: 0.6;

    .milestone-title {
      text-decoration: line-through;
    }
  }
}

.milestone-status-icon {
  .material-symbols-rounded {
    font-size: 2.2rem;
    color: var(--success);
  }
}

.milestone-info {
  flex: 1;
  min-width: 0;
}

.milestone-title {
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--text-dark);
}

.milestone-meta {
  font-size: 1.2rem;
  color: var(--text-grey);
}

.milestone-actions {
  display: flex;
  gap: 0.2rem;
  opacity: 0;
  transition: opacity 0.15s;
}

.milestone-row:hover .milestone-actions {
  opacity: 1;
}

.icon-button {
  width: 3.2rem;
  height: 3.2rem;
  border-radius: 50%;
  border: none;
  background: none;
  color: var(--text-grey);
  cursor: pointer;
  outline: none;
  @include flex-center;

  .material-symbols-rounded {
    font-size: 1.8rem;
  }

  &:hover,
  &:focus-visible {
    background-color: var(--bg-light) !important;
  }

  &--danger {
    &:hover,
    &:focus-visible,
    &:active {
      background-color: var(--danger) !important;
      color: var(--text-light) !important;
    }
  }
}

.empty-hint {
  font-size: 1.3rem;
  color: var(--text-grey);
  padding: 1.2rem 0;
}

.detail-sidebar {
  @include flex-col(1.6rem);
}

.sidebar-card {
  @include card-surface;
  padding: 2rem;

  &--dark {
    background-color: var(--main-navy);
    border: none;
  }
}

.sidebar-label {
  font-size: 1.2rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04rem;
  color: var(--text-grey);
  margin-bottom: 1.2rem;

  &--light {
    color: var(--text-muted);
  }
}

.status-select {
  width: 100%;
  box-sizing: border-box;
  font-family: inherit;
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--text-dark);
  background-color: var(--bg-light);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 1rem 1.2rem;
  cursor: pointer;

  &:focus {
    outline: none;
    border-color: var(--accent-cyan);
  }
}

.website-toggle {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: 100%;
  background-color: var(--bg-light);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 1.2rem;
  font-size: 1.3rem;
  color: var(--text-grey);
  cursor: pointer;
  text-align: left;

  .material-symbols-rounded {
    font-size: 2rem;
    flex-shrink: 0;
  }

  &--active {
    background-color: var(--accent-cyan-light);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan-hover);
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}

.sidebar-action {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: 100%;
  background: none;
  border: none;
  border-radius: var(--radius-sm);
  padding: 1rem 0.8rem;
  color: var(--text-light);
  font-size: 1.4rem;
  cursor: pointer;
  text-align: left;

  .material-symbols-rounded {
    color: var(--accent-cyan);
  }

  &:hover {
    background-color: rgba(255, 255, 255, 0.06);
  }
}

.state-panel {
  @include flex-col(1.2rem);
  align-items: center;
  padding: 6.4rem 2rem;
  color: var(--text-grey);

  .material-symbols-rounded {
    font-size: 3.6rem;
    color: var(--accent-cyan);
  }
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
</file>

