              <span class="material-symbols-rounded">check</span>
              <span>Freigeben</span>
            </button>
            <button
              class="action-button action-button--reject"
              [disabled]="processingId() === testimonial.id"
              (click)="reject(testimonial.id)"
            >
              <span class="material-symbols-rounded">close</span>
              <span>Ablehnen</span>
            </button>
          </div>
        } @else if (testimonial.status === 'APPROVED') {
          <div class="testimonial-actions">
            @if (testimonial.visibleOnWebsite) {
              <button
                class="action-button action-button--reject"
                [disabled]="processingId() === testimonial.id"
                (click)="unpublish(testimonial.id)"
              >
                <span class="material-symbols-rounded">visibility_off</span>
                <span>Von Website entfernen</span>
              </button>
            } @else {
              <button
                class="action-button action-button--approve"
                [disabled]="processingId() === testimonial.id"
                (click)="publish(testimonial.id)"
              >
                <span class="material-symbols-rounded">visibility</span>
                <span>Auf Website veröffentlichen</span>
              </button>
            }
          </div>
        }
      </div>
    } @empty {
      <div class="empty-state">
        <span class="material-symbols-rounded">rate_review</span>
        <p>Keine Referenzen in dieser Kategorie</p>
      </div>
    }
  </div>
