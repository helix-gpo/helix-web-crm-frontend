  currencyCode: string;
}

export interface Address {
  street?: string;
  houseNumber?: string;
  postalCode?: string;
  city?: string;
  countryCode?: string;
}

export interface BillingParty {
  name: string;
  vatId?: string;
  address?: Address;
  email?: string;
