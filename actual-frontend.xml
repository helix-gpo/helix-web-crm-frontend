<div class="page-header">
  <div>
    <h1 class="page-title">Mandanten</h1>
    <p class="page-subtitle">
      {{ filteredTenants().length }} von {{ tenantStore.tenants().length }} Mandanten
    </p>
  </div>
  <button class="add-button" (click)="openCreateDialog()">
    <span class="material-symbols-rounded">add</span>
    <span>Neuer Mandant</span>
  </button>
</div>

<div class="filter-bar">
  <div class="filter-search">
    <span class="material-symbols-rounded">search</span>
    <input
      type="text"
      placeholder="Mandant suchen..."
      [value]="searchTerm()"
      (input)="searchTerm.set($any($event.target).value)"
    />
  </div>
</div>

@if (tenantStore.loading()) {
  <div class="state-panel">
    <span class="material-symbols-rounded spin">progress_activity</span>
    <p>Mandanten werden geladen...</p>
  </div>
